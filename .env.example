# Copy to .env for local dev and set the same values in your Vercel project's
# Environment Variables before deploying. Never put real values in THIS file —
# .env is gitignored, .env.example is not.

# ---------------------------------------------------------------------------
# Database (required — the app will not load its fleet without it)
# ---------------------------------------------------------------------------
# Any Postgres works. Free tiers: https://neon.tech or Vercel Postgres.
# Apply the schema once with:  psql "$DATABASE_URL" -f db/schema.sql
#
# Hosted providers require TLS; api/_db.js turns SSL off automatically for
# localhost connections and on for everything else.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Vision extraction (optional — demo mode works without it)
# ---------------------------------------------------------------------------
# Only ONE of these needs to be set. api/scan.js picks Anthropic first if both
# are present: it is the more reliable structured extractor and has no daily
# request cap, which matters when the cap would be hit at the worst moment.

# Preferred: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Fallback / free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
