# Copy to .env for local dev (Vercel CLI) and set the same keys in your
# Vercel project's Environment Variables before deploying.
#
# Only ONE of these needs to be set — api/scan.js picks Anthropic first if
# both are present.
# Preferred: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Fallback / free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
